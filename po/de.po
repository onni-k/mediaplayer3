msgstr "GELB: Beschreibung"

msgid "Show description fullscreen"
msgstr "Beschreibung im Vollbild anzeigen"

msgid "No description available."
msgstr "Keine Beschreibung verfügbar."

msgid "OK / EXIT / YELLOW / LEFT / RIGHT: Close -- UP / DOWN: Scroll"
msgstr "OK / EXIT / GELB / LINKS / RECHTS: Schließen -- HOCH / RUNTER: Scrollen"

msgid "show lyrics or episode description fullscreen"
msgstr "Songtext oder Episodenbeschreibung im Vollbild anzeigen"

msgid "search or fetch popular podcasts"
msgstr "suchen oder beliebte Podcasts abrufen"

